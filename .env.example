# Copie para .env e preencha. NUNCA comite o .env real.
#   cp .env.example .env

# Banco: cactvs_payments
DATABASE_URL="mysql://cactvs:12345678@localhost:3306/cactvs_payments"

# Segredo de assinatura do JWT. Gere um novo com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="gere-um-segredo-novo-aqui"
JWT_EXPIRES_IN="3600"

PORT=3000
NODE_ENV=development

# ---------------------------------------------------------------------------
# Mensageria (ver docs/mensageria-implementacao.md)
# ---------------------------------------------------------------------------
# kafka = Kafka real (docker compose up -d) | memoria = barramento em processo
MENSAGERIA_DRIVER=memoria
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=cactvs-backend
KAFKA_REPLICACAO=1
OUTBOX_INTERVALO_MS=500

# SPI (simulador): ISPB do nosso PSP e do "outro banco"
PIX_ISPB=12345678
SPI_ISPB_CONTRAPARTE=87654321
SPI_SIMULADOR_ATRASO_MS=1500
RECONCILIACAO_APOS_SEGUNDOS=30
RECONCILIACAO_JANELA_SEGUNDOS=120

# Webhooks: chave AES-256 (32 bytes base64) que cifra os segredos HMAC.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
WEBHOOK_CHAVE_CIFRA=
# SO EM DEV: aceita http:// e localhost como URL de webhook (desliga SSRF).
WEBHOOK_PERMITIR_INSEGURO=false

# Push do app mobile: log | expo
PUSH_PROVEDOR=log
EXPO_ACCESS_TOKEN=
